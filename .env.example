# Highland Fresh environment variables
# Copy this file to `.env` and replace values for your deployment target.
# The default values below assume XAMPP / local development.
# Production values must be stored in the hosting account's private `.env`.
# Never commit a populated `.env` or paste its passwords into chat/issues.

# ===== Database =====
# [INFINITYFREE] Replace these 4 with values from your InfinityFree control panel
#                (cPanel > "MySQL Databases" section):
#   DB_HOST=sqlNNN.infinityfree.com      (e.g. sql200.epizy.com — your DB host)
#   DB_NAME=epZZ_NNNNNN_highland_fresh   (whatever DB name you created)
#   DB_USERNAME=epZZ_NNNNNN              (NOT "root" — InfinityFree uses a prefixed user)
#   DB_PASSWORD=<your InfinityFree DB password>
# [GOOGIEHOST] The database host shown in DirectAdmin is normally localhost.
#   DB_HOST=localhost
#   DB_NAME=<GoogieHost database name>
#   DB_USERNAME=<GoogieHost database username>
#   DB_PASSWORD=<GoogieHost database password>
DB_HOST=localhost
DB_PORT=3306
DB_NAME=highland_fresh
DB_USERNAME=root
DB_PASSWORD=

# ===== Application URL =====
# [INFINITYFREE] APP_URL=https://yoursite.infinityfreeapp.com
#   (omit the /HighlandFreshAppV4 subfolder ONLY if you deploy at htdocs/ root;
#    otherwise include the subfolder in the path)
APP_URL=http://localhost/HighlandFreshAppV4
# [GOOGIEHOST] APP_URL=https://highlandfresh.whf.bz

# ===== Supplier delivery calendar =====
# Weekends are always excluded from supplier lead-time calculations.
# Add optional national holidays or company/supplier closure dates in YYYY-MM-DD format.
SUPPLIER_NON_WORKING_DATES=

# ===== Security =====
# Required in production. Generate separate random values of at least 32
# characters and keep them only in the hosting account's private `.env`.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
AUDIT_LOG_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

# ===== Outbound Email =====
# Recommended on shared hosting: Brevo HTTPS API. Keep the real key only in a
# deployment secret named BREVO_API_KEY, never in this file or source control.
MAIL_TRANSPORT=brevo_api
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY

# SMTP fallback. GoogieHost support assigned cloud3.googiehost.com:465, but the
# live PHP worker may block that route. Verify either transport from Admin ->
# Test Email Service.
SMTP_HOST=cloud3.googiehost.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_VERIFY_PEER=true
SMTP_USERNAME=notifications@highlandfresh.whf.bz
SMTP_FROM_EMAIL=notifications@highlandfresh.whf.bz
SMTP_FROM_NAME=Highland Fresh Dairy
# Keep the real mailbox password only in the host's private .env or deployment secret.
SMTP_PASSWORD=REPLACE_WITH_HOST_MAILBOX_PASSWORD

# ===== Institutional Customer Order Inbox =====
# The Sales "Customer PO Inbox" saves customer PO attachments, usually PDF,
# so Sales can view the original and enter the agreed order without switching apps.
# Gmail uses pop.gmail.com:995 with SSL and an App Password.
ORDER_MAILBOX_ENABLED=false
ORDER_MAILBOX_HOST=pop.gmail.com
ORDER_MAILBOX_PORT=995
ORDER_MAILBOX_ENCRYPTION=ssl
ORDER_MAILBOX_USERNAME=orders@example.com
ORDER_MAILBOX_PASSWORD=REPLACE_WITH_MAILBOX_APP_PASSWORD
ORDER_MAILBOX_RECENT_MODE=false
ORDER_MAILBOX_MAX_MESSAGES=20
